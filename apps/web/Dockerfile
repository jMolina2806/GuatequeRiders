FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_LEGAL_RESPONSIBLE
ARG VITE_LEGAL_CONTACT_EMAIL
ARG VITE_LEGAL_CONTACT_ADDRESS
ARG VITE_MERCH_SELLER

ENV VITE_LEGAL_RESPONSIBLE=$VITE_LEGAL_RESPONSIBLE
ENV VITE_LEGAL_CONTACT_EMAIL=$VITE_LEGAL_CONTACT_EMAIL
ENV VITE_LEGAL_CONTACT_ADDRESS=$VITE_LEGAL_CONTACT_ADDRESS
ENV VITE_MERCH_SELLER=$VITE_MERCH_SELLER

RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
