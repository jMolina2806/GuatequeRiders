# Configuración local. Los archivos .env y .env.* están ignorados por Git.

# Enlace privado del grupo de WhatsApp. Copia esta variable a .env.
APP_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/REEMPLAZAR

# URL pública usada en enlaces de emails y retornos externos.
APP_PUBLIC_URL=http://localhost:5173

# Email. En local puedes usar Mailpit con estos valores.
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM="Guateque Riders <no-reply@guatequeriders.local>"
MAIL_USERNAME=
MAIL_PASSWORD=
UNSUBSCRIBE_SECRET=REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Clave Stripe TEST. Guárdala en .env.stripe.local para usar Run Demo Stripe.
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
